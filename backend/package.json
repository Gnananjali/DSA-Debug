{
  "name": "dsadebug-backend",
  "version": "1.0.0",
  "description": "DSADebug API - auth, problems, submissions, sandboxed code execution queue, AI analysis",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "start:all": "node start.js",
    "dev": "nodemon server.js",
    "worker": "node queue/executionWorker.js",
    "seed": "node seed/problems.seed.js",
    "make-admin": "node scripts/makeAdmin.js",
    "sandbox:build": "docker build -t dsadebug-runner:latest ./sandbox",
    "test": "node --test"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "groq-sdk": "^1.6.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "morgan": "^1.10.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
